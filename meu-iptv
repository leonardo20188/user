#clapprPlayer{
    width:100%;
    height:480px;
    background:#000;
}

.iptv-now{
    padding:12px;
    background:#11161d;
    font-size:14px;
}

.iptv-now span{
    color:var(--muted);
}

.iptv-diagnostic{
    padding:10px 12px;
    background:#0d1218;
    color:#8993a1;
    font-size:12px;
