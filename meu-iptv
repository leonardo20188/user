}

.iptv-diagnostic.ok{
    color:#7ee787;
}

.iptv-diagnostic.error{
    color:#ff7777;
}

.iptv-count{
    color:var(--muted);
    font-size:13px;
    margin:18px 0 12px;
}

.iptv-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(150px,1fr));
    gap:12px;
}

.iptv-channel{
    position:relative;
    min-height:145px;
    padding:12px;
    background:var(--panel);
    border:1px solid var(--border);
