            id="iptvSearch"
            class="iptv-search"
            type="search"
            placeholder="🔎 Pesquisar canal..."
        >

    </div>


    <div class="iptv-layout">

        <aside class="iptv-sidebar">

            <div class="iptv-sidebar-title">
                Categorias
            </div>

            <button
                class="iptv-category active"
                data-cat="TODOS">
                Todos
            </button>

            <button
                class="iptv-category"
                data-cat="FAVORITOS">
                ⭐ Favoritos
            </button>

            <div id="iptvCategories"></div>

        </aside>


        <main class="iptv-content">

            <div class="iptv-player">

                <div id="clapprPlayer"></div>

                <div class="iptv-now">
                    <span>Assistindo:</span>
                    <strong id="iptvCurrent">
