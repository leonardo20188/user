<style>
#iptvApp{
    --bg:#070a0f;
    --panel:#11161d;
    --panel2:#191f28;
    --border:#29313c;
    --text:#f5f7fa;
    --muted:#8993a1;
    --red:#e50914;
    background:var(--bg);
    color:var(--text);
    width:100%;
    min-height:700px;
    font-family:Arial,sans-serif;
}

#iptvApp *{
    box-sizing:border-box;
}

.iptv-header{
    padding:18px;
    background:linear-gradient(180deg,#121820,#070a0f);
    border-bottom:1px solid var(--border);
}

.iptv-title{
    font-size:24px;
    font-weight:bold;
    margin-bottom:15px;
}

.iptv-live{
    background:var(--red);
    padding:5px 8px;
    border-radius:5px;
    font-size:11px;
    margin-right:8px;
}

.iptv-search{
    width:100%;
    padding:13px;
    background:#080b10;
    color:white;
    border:1px solid var(--border);
    border-radius:8px;
    outline:none;
}

.iptv-layout{
    display:grid;
    grid-template-columns:220px 1fr;
}

.iptv-sidebar{
    background:#0c1117;
    border-right:1px solid var(--border);
    padding:12px;
}

.iptv-sidebar-title{
    color:var(--muted);
    font-size:11px;
    margin:8px;
    text-transform:uppercase;
}

.iptv-category{
    width:100%;
    padding:11px;
    margin-bottom:4px;
    border:0;
    border-radius:7px;
    background:transparent;
    color:#cbd2da;
    text-align:left;
    cursor:pointer;
}

.iptv-category:hover,
.iptv-category.active{
    background:var(--panel2);
    color:white;
}

.iptv-content{
    padding:18px;
}

.iptv-player{
    background:#000;
    border:1px solid var(--border);
    border-radius:10px;
